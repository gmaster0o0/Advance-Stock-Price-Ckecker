# PostgreSQL credentials for local development
POSTGRES_USER="<user>"
POSTGRES_PASSWORD="<password>"
POSTGRES_DB="<dev_db_name>"

# Database names for test and CI
TEST_POSTGRES_DB="<test_db_name>"

# Connection URLs used by the application.
# For tests running on the host, use localhost:5433 instead of postgres-test:5432.
DATABASE_URL="postgresql://<user>:<password>@postgres-dev:5432/<dev_db_name>?schema=public"
TEST_DATABASE_URL="postgresql://<user>:<password>@postgres-test:5432/<test_db_name>?schema=public"
